SELECT * FROM products;

UPDATE products 
SET unit_price = 12.99 
WHERE product_name = 'Wireless Mouse';

DELETE FROM products 
WHERE product_name = 'Whiteboard Eraser';

SELECT * FROM products;

SELECT product_name AS "Item Name", unit_price AS "Price" 
FROM products;

SELECT product_name, (unit_price * quantity_in_stock) AS "Total Value" 
FROM products;

SELECT product_name || ' (' || category || ')' AS "Product Listing" 
FROM products;

SELECT * FROM products 
WHERE category = 'Electronics' AND unit_price > 20;

SELECT * FROM products 
WHERE unit_price BETWEEN 10 AND 50;

SELECT * FROM products 
ORDER BY quantity_in_stock DESC;

SELECT SUM(quantity_in_stock) AS "Total Stock Quantity" 
FROM products;

SELECT COUNT(*) AS "Office Supplies Count" 
FROM products 
WHERE category = 'Office Supplies';
